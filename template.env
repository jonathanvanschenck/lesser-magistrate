# DigiKey API credentials for tools/digikey/dk.mjs
#
# Copy this file to `.env` (which git ignores) and fill in the values.
# Never commit .env. See the "DigiKey CLI" section of DEVELOPMENT.md for how
# to create the credentials.

# Required: from your Production App at https://developer.digikey.com
DIGIKEY_CLIENT_ID=
DIGIKEY_CLIENT_SECRET=

# Optional: localization for prices and stock (defaults shown)
DIGIKEY_LOCALE_SITE=US
DIGIKEY_LOCALE_LANGUAGE=en
DIGIKEY_LOCALE_CURRENCY=USD

# Optional: your DigiKey customer/account number, for account-specific pricing
# DIGIKEY_CUSTOMER_ID=

# Optional: set to 1 to use a Sandbox App's credentials (sandbox returns canned data)
# DIGIKEY_SANDBOX=1
